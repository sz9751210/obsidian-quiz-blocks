{
	"name": "quiz-blocks",
	"version": "1.0.1",
	"main": "main.js",
	"type": "module",
	"private": true,
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"generate-yaml-parser": "lezer-generator src/syntax-highlighter/yaml.grammar -o src/syntax-highlighter/parser",
		"generate-yaml-parser-with-debug-symbols": "lezer-generator src/syntax-highlighter/yaml.grammar --names -o src/syntax-highlighter/parser",
		"lint": "eslint . && svelte-check --tsconfig tsconfig.json"
	},
	"devDependencies": {
		"@eslint/js": "9.39.2",
		"@lezer/generator": "1.8.0",
		"@types/node": "25.0.3",
		"esbuild": "0.27.2",
		"esbuild-svelte": "^0.9.4",
		"eslint": "^9.39.2",
		"eslint-plugin-obsidianmd": "0.1.9",
		"globals": "17.0.0",
		"jiti": "2.6.1",
		"svelte": "^5.46.4",
		"svelte-check": "^4.3.5",
		"svelte-preprocess": "^6.0.3",
		"tslib": "2.8.1",
		"typescript": "5.9.3",
		"typescript-eslint": "8.52.0"
	},
	"dependencies": {
		"@codemirror/language": "*",
		"@codemirror/state": "*",
		"@codemirror/view": "*",
		"@lezer/common": "*",
		"@lezer/highlight": "*",
		"@lezer/lr": "*",
		"codemirror": "*",
		"obsidian": "latest",
		"svelte-autosize": "^1.1.5",
		"yaml": "2.8.2",
		"zod": "4.3.5"
	}
}
